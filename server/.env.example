# TEMPLATE ONLY. Don't put real keys here.
# Real values live in ~/.config/heritage-chat/server.env, created by `npm run setup`.
# Optional settings below can be added to that file too.
PORT=4000
# Only matters if the web app calls the API cross-origin (deployed separately).
# Comma-separate several: http://localhost:5173,https://your-app.vercel.app
WEB_ORIGIN=http://localhost:5173

# Supabase → Project Settings → API. The service role key bypasses RLS:
# it must only ever live on the server.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=
# Optional overrides
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
AUDIO_BUCKET=audio
