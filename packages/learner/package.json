{
  "name": "@heirloom/learner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LLTA learner model: pure functions, no I/O. Port of docs/reference/learner_model.py.",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
