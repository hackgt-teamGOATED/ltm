#!/bin/sh
# Blocks commits that include env files or anything that looks like an API key.
# Installed by `npm run setup` (git config core.hooksPath scripts/hooks).

blocked=0
for f in $(git diff --cached --name-only --diff-filter=ACMR); do
  case "$f" in
    *.env.example) ;;
    .env|*/.env|*.env|*.env.local|*/.env.*)
      echo "✋ Refusing to commit $f (looks like a secrets file)."
      blocked=1 ;;
  esac
done

if git diff --cached -U0 --diff-filter=ACMR | grep '^+' | grep -v '^+++' \
  | grep -Eq '(sk-(proj-|svcacct-)?[A-Za-z0-9_-]{20,}|sb_secret_[A-Za-z0-9_-]{10,}|eyJ[A-Za-z0-9_-]{30,}\.[A-Za-z0-9_-]{30,})'; then
  echo "✋ This commit contains something that looks like an API key."
  echo "   Remove it (keys belong in ~/.config/heritage-chat/server.env) and try again."
  blocked=1
fi

if [ "$blocked" -ne 0 ]; then
  echo "   (If this is a false alarm, ask the team before using --no-verify.)"
  exit 1
fi
